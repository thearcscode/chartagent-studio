chartagent-studio/.github
chartagent-studio/app/.venv
chartagent-studio/app/**/__pycache__
chartagent-studio/web/node_modules
chartagent-studio/web/dist

chartagent/.git
chartagent/.venv
chartagent/**/__pycache__
chartagent/prototypes
